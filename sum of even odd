 #include<stdio.h>
int main() {
int n;
printf("enter the number:");
scanf("%d", &n);
int evensum=0;
int oddsum=0;
for (int i=1;i<=n;i++){ if (i%2==0)
evensum=evensum+i;}
for (int i=1;i<=n;i++){ if(i%2!=0)
oddsum=oddsum+i;
}

printf("\nsum of even numbers is %d", evensum);
printf("\nsum of odd number is %d", oddsum); 
return 0;
}
